<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Family Purify"
    Height="860"
    Width="1040"
    WindowStartupLocation="CenterScreen"
    Background="#1C1C28"
    ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#26263C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#26263C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#55557A"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="6,1,6,1"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="#26263C"
                                                  BorderThickness="0">
                                        <Path Fill="White"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#26263C"
                                        BorderBrush="#55557A"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Family Purify"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#00FFC3"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Clean, optimize and standardize Revit families."
                       FontSize="13"
                       Foreground="#BBBBBB"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="1. Select Families"
                      Foreground="#E0E0E0"
                      BorderBrush="#444466"
                      Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Open family documents"
                                   Foreground="#BBBBBB"
                                   Margin="0,0,0,6"/>
                        <ListBox Grid.Row="1"
                                 x:Name="FamiliesList"
                                 Background="#26263C"
                                 Foreground="White"
                                 SelectionMode="Extended"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="family_selection_changed"/>
                    </Grid>

                    <GroupBox Grid.Row="2"
                              Header="Family Summary"
                              Foreground="#E0E0E0"
                              BorderBrush="#444466"
                              Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="SummaryFileSizeText"
                                       Text="File size: --"
                                       Foreground="White"
                                       Margin="0,2"/>
                            <TextBlock x:Name="SummaryTypesText"
                                       Text="Family types: --"
                                       Foreground="White"
                                       Margin="0,2"/>
                            <TextBlock x:Name="SummaryNestedText"
                                       Text="Nested families: --"
                                       Foreground="White"
                                       Margin="0,2"/>
                            <TextBlock x:Name="SummarySharedParamsText"
                                       Text="Shared parameters: --"
                                       Foreground="White"
                                       Margin="0,2"/>
                            <TextBlock x:Name="SummaryStatusText"
                                       Text="Status: Select a family"
                                       Foreground="#00FFC3"
                                       FontWeight="Bold"
                                       Margin="0,8,0,2"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </GroupBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="2. Cleanup"
                              Foreground="#E0E0E0"
                              BorderBrush="#444466"
                              Padding="8"
                              Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="General"
                                       FontWeight="Bold"
                                       Foreground="#00FFC3"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Optional output/new family name:"
                                           VerticalAlignment="Center"
                                           Foreground="#BBBBBB"
                                           Width="210"/>
                                <TextBox x:Name="RenameBox"
                                         Width="390"
                                         Height="26"
                                         Background="#26263C"
                                         Foreground="White"
                                         BorderBrush="#55557A"/>
                            </StackPanel>
                            <CheckBox x:Name="KeepCoreViewsChk"
                                      Content="Keep core views"
                                      IsChecked="True"
                                      Foreground="White"
                                      Margin="0,3,0,12"/>

                            <TextBlock Text="Basic Clean"
                                       FontWeight="Bold"
                                       Foreground="#00FFC3"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <CheckBox x:Name="RemoveCADImportsChk"
                                              Content="Remove CAD Imports"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                    <CheckBox x:Name="RemoveImagesChk"
                                              Content="Remove Images"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                    <CheckBox x:Name="KeepOnlyUsedMaterialsChk"
                                              Content="Remove Unused Materials"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <CheckBox x:Name="PurgePatternsAssetsChk"
                                              Content="Purge Patterns and Appearance Assets"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                    <CheckBox x:Name="PurgeSubcategoriesChk"
                                              Content="Purge Subcategories"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                    <CheckBox x:Name="CompactSaveChk"
                                              Content="Compact Save"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="0,3"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <Expander Header="3. Advanced Cleanup"
                              IsExpanded="False"
                              Foreground="#E0E0E0"
                              Background="#1C1C28"
                              BorderBrush="#444466"
                              Margin="0,0,0,10">
                        <Border BorderBrush="#444466" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="ProcessNestedChk"
                                          Content="Process nested families"
                                          IsChecked="True"
                                          Foreground="White"
                                          Margin="0,3"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                    <TextBlock Text="Nested family cleanup mode:"
                                               Foreground="#BBBBBB"
                                               VerticalAlignment="Center"
                                               Width="190"/>
                                    <ComboBox x:Name="NestedModeCombo"
                                              Width="390"
                                              SelectedIndex="0">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ProcessNestedChk}" Value="True">
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBoxItem Content="Safe: size-focused cleanup (recommended)"/>
                                        <ComboBoxItem Content="Full: clean nested like parent (more aggressive)"/>
                                    </ComboBox>
                                </StackPanel>

                                <TextBlock Text="Family Types to Remove"
                                           Foreground="#BBBBBB"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="DeleteSelectedTypesChk"
                                          Content="Delete selected family types"
                                          IsChecked="True"
                                          Foreground="White"
                                          Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Select All"
                                            Width="90"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_all_types"/>
                                    <Button Content="Select None"
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_none_types"/>
                                </StackPanel>
                                <ListBox x:Name="TypesList"
                                         Height="120"
                                         Background="#26263C"
                                         Foreground="White"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="4. Parameter Standardization"
                              IsExpanded="False"
                              Foreground="#E0E0E0"
                              Background="#1C1C28"
                              BorderBrush="#444466"
                              Margin="0,0,0,10">
                        <Border BorderBrush="#444466" BorderThickness="1" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Parameters to keep"
                                           Foreground="#BBBBBB"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Select All"
                                            Width="90"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_all_params"/>
                                    <Button Content="Select None"
                                            Width="90"
                                            Margin="8,0,0,0"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_none_params"/>
                                </StackPanel>
                                <ListBox x:Name="ParamsList"
                                         Height="105"
                                         Background="#26263C"
                                         Foreground="White"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox x:Name="AddCompanyParamsChk"
                                              Content="Add selected shared parameters"
                                              IsChecked="False"
                                              Foreground="White"
                                              VerticalAlignment="Center"/>
                                    <Button Content="Pick File"
                                            Width="82"
                                            Margin="12,0,0,0"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="browse_company_params"/>
                                    <Button Content="Select All"
                                            Width="82"
                                            Margin="8,0,0,0"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_all_company_params"/>
                                    <Button Content="Select None"
                                            Width="88"
                                            Margin="8,0,0,0"
                                            Background="#55557A"
                                            Foreground="White"
                                            Click="select_none_company_params"/>
                                </StackPanel>

                                <TextBlock x:Name="CompanyParamFileLabel"
                                           Text="No shared parameter file selected"
                                           Foreground="#BBBBBB"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Parameter kind:"
                                               Foreground="#BBBBBB"
                                               VerticalAlignment="Center"
                                               Width="110"/>
                                    <ComboBox x:Name="CompanyParamKindCombo"
                                              Width="220"
                                              SelectedIndex="0"
                                              Style="{StaticResource DarkComboBoxStyle}">
                                        <ComboBoxItem Content="Instance"/>
                                        <ComboBoxItem Content="Type"/>
                                    </ComboBox>
                                    <CheckBox x:Name="CompanyParamsNestedChk"
                                              Content="Also add to nested families"
                                              IsChecked="True"
                                              Foreground="White"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>

                                <ListBox x:Name="CompanyParamsList"
                                         Height="150"
                                         Background="#26263C"
                                         Foreground="White"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <GroupBox Header="5. Review &amp; Execute"
                              Foreground="#E0E0E0"
                              BorderBrush="#444466"
                              Padding="8">
                        <CheckBox x:Name="ScanOnlyChk"
                                  Content="Preview cleanup (no changes made)"
                                  IsChecked="False"
                                  Foreground="White"
                                  Margin="0,0,0,8"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="&#x2728; Purify Families"
                    Width="240"
                    Height="34"
                    Background="#00FFC3"
                    Foreground="Black"
                    Margin="0,0,10,0"
                    Click="clean_selected"/>
            <Button Content="Close"
                    Width="90"
                    Height="34"
                    Background="#55557A"
                    Foreground="White"
                    Click="close_window"/>
        </StackPanel>
    </Grid>
</Window>
