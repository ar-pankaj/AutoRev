<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Load View Filters From Link"
    Height="600"
    Width="450"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>

        <!-- ============================================================ -->
        <!-- COLOUR PALETTE                                               -->
        <!-- ============================================================ -->

        <SolidColorBrush x:Key="HeaderBackground" Color="#D7DCE2"/>
        <SolidColorBrush x:Key="MainBackground" Color="#E8EAED"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextBlack" Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#2589BD"/>

        <SolidColorBrush x:Key="ButtonNormal" Color="#2563A6"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#16A34A"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#0F7A35"/>

        <SolidColorBrush x:Key="BorderGreen" Color="#22A447"/>
        <SolidColorBrush x:Key="BorderBlue" Color="#2589BD"/>

        <SolidColorBrush x:Key="SelectedBackground" Color="#CDEED8"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#DDECF2"/>
        <SolidColorBrush x:Key="DisabledBackground" Color="#B8C0C8"/>
        <SolidColorBrush x:Key="DisabledText" Color="#707A85"/>
        <SolidColorBrush x:Key="ScrollTrack" Color="#D4D9DE"/>


        <!-- ============================================================ -->
        <!-- GENERAL TEXT                                                 -->
        <!-- ============================================================ -->

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontFamily" Value="Arial"/>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>


        <!-- ============================================================ -->
        <!-- NAMED TEXT STYLES                                            -->
        <!-- ============================================================ -->

        <Style x:Key="BrandTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WindowTitleStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SearchLabelStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FooterTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>


        <!-- ============================================================ -->
        <!-- BUTTON STYLE                                                 -->
        <!-- ============================================================ -->

        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ButtonNormal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonHover}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonPressed}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.85"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBackground}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource DisabledBackground}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.65"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================================ -->
        <!-- EXPLICIT WHITE SEARCH TEXTBOX STYLE                          -->
        <!-- ============================================================ -->

        <Style
            x:Key="WhiteSearchBoxStyle"
            TargetType="{x:Type TextBox}">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="CaretBrush" Value="#111111"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border
                            x:Name="TextBoxBorder"
                            Background="#FFFFFF"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">

                            <Grid Background="#FFFFFF">

                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    Background="#FFFFFF"
                                    Foreground="#111111"
                                    Focusable="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderBlue}"/>

                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="BorderThickness"
                                    Value="2"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="TextBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBackground}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- EXPLICIT WHITE COMBOBOX TOGGLE TEMPLATE                      -->
        <!-- ============================================================ -->

        <ControlTemplate
            x:Key="WhiteComboToggleTemplate"
            TargetType="{x:Type ToggleButton}">

            <Grid Background="#FFFFFF">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ComboBorder"
                    Grid.ColumnSpan="2"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBlue}"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True"/>

                <Border
                    x:Name="ArrowBackground"
                    Grid.Column="1"
                    Background="#FFFFFF"
                    BorderBrush="{StaticResource BorderBlue}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,6,6,0"/>

                <Path
                    x:Name="Arrow"
                    Grid.Column="1"
                    Width="8"
                    Height="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="#111111"
                    Data="M 0 0 L 4 4 L 8 0 Z"/>

            </Grid>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter
                        TargetName="ComboBorder"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource HoverBackground}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter
                        TargetName="ComboBorder"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource SelectedBackground}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter
                        TargetName="ComboBorder"
                        Property="Background"
                        Value="{StaticResource DisabledBackground}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource DisabledBackground}"/>

                    <Setter
                        TargetName="Arrow"
                        Property="Fill"
                        Value="{StaticResource DisabledText}"/>
                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>


        <!-- ============================================================ -->
        <!-- EXPLICIT WHITE COMBOBOX ITEM STYLE                           -->
        <!-- ============================================================ -->

        <Style
            x:Key="WhiteComboBoxItemStyle"
            TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border
                            x:Name="ItemBorder"
                            Background="#FFFFFF"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">

                            <ContentPresenter
                                TextElement.Foreground="#111111"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource HoverBackground}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource SelectedBackground}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- EXPLICIT WHITE LINK COMBOBOX STYLE                           -->
        <!-- ============================================================ -->

        <Style
            x:Key="WhiteLinkComboBoxStyle"
            TargetType="{x:Type ComboBox}">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource WhiteComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Border
                            x:Name="ComboOuterBorder"
                            Background="#FFFFFF"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">

                            <Grid Background="#FFFFFF">

                                <ToggleButton
                                    x:Name="ToggleButton"
                                    Background="#FFFFFF"
                                    Foreground="#111111"
                                    Template="{StaticResource WhiteComboToggleTemplate}"
                                    Focusable="False"
                                    ClickMode="Press"
                                    IsChecked="{Binding IsDropDownOpen,
                                        Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"/>

                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="8,3,34,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    TextElement.Foreground="#111111"/>

                                <Popup
                                    x:Name="Popup"
                                    Placement="Bottom"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="Slide">

                                    <Grid
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="Transparent">

                                        <Border
                                            x:Name="DropDownBorder"
                                            Margin="0,3,0,0"
                                            Background="#FFFFFF"
                                            BorderBrush="{StaticResource BorderGreen}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            SnapsToDevicePixels="True">

                                            <ScrollViewer
                                                Margin="5,8"
                                                Background="#FFFFFF"
                                                VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled">

                                                <StackPanel
                                                    IsItemsHost="True"
                                                    Background="#FFFFFF"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>

                                            </ScrollViewer>

                                        </Border>

                                    </Grid>

                                </Popup>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="HasItems" Value="False">
                                <Setter
                                    TargetName="DropDownBorder"
                                    Property="MinHeight"
                                    Value="40"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    TargetName="ComboOuterBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBackground}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- CHECKBOX STYLE                                               -->
        <!-- ============================================================ -->

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,3"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <Border
                            x:Name="ItemBackground"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="3">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="3">

                                    <Path
                                        x:Name="CheckMark"
                                        Width="9"
                                        Height="7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="White"
                                        StrokeThickness="2"
                                        Visibility="Collapsed"
                                        Data="M 0 3 L 3 6 L 9 0"/>

                                </Border>

                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                                    TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource BorderGreen}"/>

                                <Setter
                                    TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                                <Setter
                                    TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>

                                <Setter
                                    TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{StaticResource SelectedBackground}"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ItemBackground"
                                    Property="Background"
                                    Value="{StaticResource HoverBackground}"/>

                                <Setter
                                    TargetName="CheckBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                                <Setter
                                    TargetName="CheckBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBackground}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- SCROLLBAR THUMB                                              -->
        <!-- ============================================================ -->

        <Style
            x:Key="VerticalScrollBarThumb"
            TargetType="{x:Type Thumb}">

            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinHeight" Value="22"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Thumb}">

                        <Border
                            x:Name="ThumbBorder"
                            Background="{StaticResource BorderBlue}"
                            CornerRadius="5"
                            Margin="1"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter
                                    TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsDragging" Value="True">
                                <Setter
                                    TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonHover}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <!-- ============================================================ -->
        <!-- SCROLLBAR                                                    -->
        <!-- ============================================================ -->

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="{StaticResource ScrollTrack}"/>
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Grid Background="{TemplateBinding Background}">

                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"/>

                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Focusable="False">

                                <Track.DecreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>
                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>
                                    <Thumb
                                        Style="{StaticResource VerticalScrollBarThumb}"/>
                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>
                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>
                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <!-- ================================================================ -->
    <!-- ROUNDED WINDOW                                                   -->
    <!-- ================================================================ -->

    <Border
        Background="{StaticResource MainBackground}"
        BorderBrush="{StaticResource BorderGreen}"
        BorderThickness="1"
        CornerRadius="14"
        SnapsToDevicePixels="True">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="27"/>
            </Grid.RowDefinitions>


            <!-- ======================================================== -->
            <!-- HEADER                                                   -->
            <!-- ======================================================== -->

            <Border
                Grid.Row="0"
                Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource BorderGreen}"
                BorderThickness="0,0,0,1"
                CornerRadius="13,13,0,0"
                MouseDown="header_drag">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource BrandTextStyle}"
                        Text="pyRevix"
                        Margin="8,0,0,0"/>

                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource WindowTitleStyle}"
                        Text="Load View Filters From Link"/>

                    <Button
                        Grid.Column="2"
                        Content="Close"
                        Width="58"
                        Height="21"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="button_close"/>

                </Grid>

            </Border>


            <!-- ======================================================== -->
            <!-- MAIN CONTENT                                             -->
            <!-- ======================================================== -->

            <Grid
                Grid.Row="1"
                Margin="12,10,12,8">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Source link -->

                <Label
                    Grid.Row="0"
                    Content="1. Select Source Revit Link:"/>

                <ComboBox
                    x:Name="combo_links"
                    Grid.Row="1"
                    Style="{StaticResource WhiteLinkComboBoxStyle}"
                    Margin="5,0"
                    SelectionChanged="link_selection_changed"/>


                <!-- Separator -->

                <Separator
                    Grid.Row="2"
                    Margin="5,8,5,4"
                    Background="{StaticResource BorderGreen}"/>


                <!-- Filters -->

                <Label
                    Grid.Row="3"
                    Content="2. Select Filters From Link:"/>


                <!-- Search -->

                <DockPanel
                    Grid.Row="4"
                    Margin="5,0,5,6">

                    <TextBlock
                        Style="{StaticResource SearchLabelStyle}"
                        Text="Search"
                        Margin="0,0,8,0"/>

                    <TextBox
                        x:Name="textbox_filter"
                        Style="{StaticResource WhiteSearchBoxStyle}"
                        Height="27"
                        TextChanged="filter_text_changed"/>

                </DockPanel>


                <!-- Filter list -->

                <Border
                    Grid.Row="5"
                    Margin="5,0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderGreen}"
                    BorderThickness="1"
                    CornerRadius="9">

                    <ScrollViewer
                        Margin="4"
                        Background="Transparent"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel
                            x:Name="filters_panel"
                            Background="Transparent"/>

                    </ScrollViewer>

                </Border>


                <!-- Filter count -->

                <TextBlock
                    x:Name="filter_count_text"
                    Grid.Row="6"
                    Style="{StaticResource StatusTextStyle}"
                    Text="Select a loaded link to display filters."
                    Margin="8,5,5,1"/>


                <!-- Selection buttons -->

                <StackPanel
                    Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

                    <Button
                        Content="Select All"
                        Width="105"
                        Height="25"
                        Margin="5"
                        Click="button_select_all"/>

                    <Button
                        Content="Select None"
                        Width="105"
                        Height="25"
                        Margin="5"
                        Click="button_select_none"/>

                </StackPanel>


                <!-- Load button -->

                <Button
                    x:Name="button_load"
                    Grid.Row="8"
                    Content="Load Selected Filters"
                    Width="220"
                    Height="32"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    IsEnabled="False"
                    Click="button_run"/>

            </Grid>


            <!-- ======================================================== -->
            <!-- FOOTER                                                   -->
            <!-- ======================================================== -->

            <Border
                Grid.Row="2"
                Background="{StaticResource HeaderBackground}"
                BorderBrush="{StaticResource BorderGreen}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,13,13">

                <TextBlock
                    Style="{StaticResource FooterTextStyle}"
                    Text="Version 1.0"/>

            </Border>

        </Grid>

    </Border>

</Window>