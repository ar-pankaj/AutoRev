<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Load View Filters From Link"
    Height="600" Width="450"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="True"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>

        <!-- Colours -->
        <SolidColorBrush x:Key="HeaderBackground" Color="#D7DCE2"/>
        <SolidColorBrush x:Key="MainBackground" Color="#E8EAED"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBlack" Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#2589BD"/>
        <SolidColorBrush x:Key="ButtonNormal" Color="#2563A6"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#16A34A"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#0F7A35"/>
        <SolidColorBrush x:Key="BorderGreen" Color="#22A447"/>
        <SolidColorBrush x:Key="BorderBlue" Color="#2589BD"/>
        <SolidColorBrush x:Key="SelectedBackground" Color="#CDEED8"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#DDECF2"/>
        <SolidColorBrush x:Key="DisabledBackground" Color="#B8C0C8"/>
        <SolidColorBrush x:Key="DisabledText" Color="#707A85"/>
        <SolidColorBrush x:Key="ScrollTrack" Color="#D4D9DE"/>

        <!-- Text -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontFamily" Value="Arial"/>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>

        <Style x:Key="BrandTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource BrandBlue}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WindowTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SearchLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="FooterTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- Button -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ButtonNormal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource ButtonHover}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource ButtonPressed}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DisabledBackground}"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource DisabledBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource DisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box -->
        <Style x:Key="WhiteSearchBoxStyle"
               TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxBorder"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox arrow -->
        <ControlTemplate x:Key="WhiteComboToggleTemplate"
                         TargetType="{x:Type ToggleButton}">
            <Grid Background="{StaticResource InputBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ComboBorder"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource BorderBlue}"
                        BorderThickness="1"
                        CornerRadius="6"/>

                <Border x:Name="ArrowBackground"
                        Grid.Column="1"
                        Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource BorderBlue}"
                        BorderThickness="1,0,0,0"
                        CornerRadius="0,6,6,0"/>

                <Path Grid.Column="1"
                      Width="8" Height="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{StaticResource TextBlack}"
                      Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ComboBorder"
                            Property="BorderBrush"
                            Value="{StaticResource BorderGreen}"/>
                    <Setter TargetName="ArrowBackground"
                            Property="Background"
                            Value="{StaticResource HoverBackground}"/>
                </Trigger>

                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ComboBorder"
                            Property="BorderBrush"
                            Value="{StaticResource BorderGreen}"/>
                    <Setter TargetName="ArrowBackground"
                            Property="Background"
                            Value="{StaticResource SelectedBackground}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox items -->
        <Style x:Key="WhiteComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Arial"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">

                            <ContentPresenter
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverBackground}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource SelectedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link ComboBox -->
        <Style x:Key="WhiteLinkComboBoxStyle"
               TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource WhiteComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid Background="{StaticResource InputBackground}">

                            <ToggleButton
                                Template="{StaticResource WhiteComboToggleTemplate}"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}"/>

                            <ContentPresenter
                                Margin="8,3,34,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">

                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="{StaticResource InputBackground}"
                                        BorderBrush="{StaticResource BorderGreen}"
                                        BorderThickness="1"
                                        CornerRadius="6">

                                    <ScrollViewer Margin="5,8">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection checkbox indicator -->
        <Style x:Key="FilterCheckBoxStyle"
               TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Width="15" Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="3">

                                <Path x:Name="CheckMark"
                                      Width="9" Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Data="M 0 3 L 3 6 L 9 0"/>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="4,0"
                                              VerticalAlignment="Center"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder"
                                        Property="Background"
                                        Value="{StaticResource BorderGreen}"/>
                                <Setter TargetName="CheckBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderGreen}"/>
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Extended-selection ListBox -->
        <Style x:Key="FilterListBoxStyle"
               TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing"
                    Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode"
                    Value="Recycling"/>
        </Style>

        <Style x:Key="FilterListBoxItemStyle"
               TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBlack}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ListItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ListItemBorder"
                                        Property="Background"
                                        Value="{StaticResource HoverBackground}"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ListItemBorder"
                                        Property="Background"
                                        Value="{StaticResource SelectedBackground}"/>
                                <Setter TargetName="ListItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderGreen}"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ListItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource BorderBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Window body -->
    <Border Background="{StaticResource MainBackground}"
            BorderBrush="{StaticResource BorderGreen}"
            BorderThickness="1"
            CornerRadius="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="27"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBackground}"
                    BorderBrush="{StaticResource BorderGreen}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    MouseDown="header_drag">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource BrandTextStyle}"
                               Text="pyRevix"
                               Margin="8,0,0,0"/>

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource WindowTitleStyle}"
                               Text="Load View Filters From Link"/>

                    <Button Grid.Column="2"
                            Content="Close"
                            Width="58" Height="21"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="button_close"/>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1"
                  Margin="12,10,12,8">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Content="1. Select Source Revit Link:"/>

                <ComboBox x:Name="combo_links"
                          Grid.Row="1"
                          Style="{StaticResource WhiteLinkComboBoxStyle}"
                          Margin="5,0"
                          SelectionChanged="link_selection_changed"/>

                <Separator Grid.Row="2"
                           Margin="5,8,5,4"
                           Background="{StaticResource BorderGreen}"/>

                <Label Grid.Row="3"
                       Content="2. Select Filters From Link:"/>

                <DockPanel Grid.Row="4"
                           Margin="5,0,5,6">

                    <TextBlock
                        Style="{StaticResource SearchLabelStyle}"
                        Text="Search"
                        Margin="0,0,8,0"/>

                    <TextBox
                        x:Name="textbox_filter"
                        Style="{StaticResource WhiteSearchBoxStyle}"
                        Height="27"
                        TextChanged="filter_text_changed"/>
                </DockPanel>

                <!-- Native Shift/Ctrl selection -->
                <Border Grid.Row="5"
                        Margin="5,0"
                        Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderGreen}"
                        BorderThickness="1"
                        CornerRadius="9"
                        ClipToBounds="True">

                    <ListBox
                        x:Name="filters_list"
                        Style="{StaticResource FilterListBoxStyle}"
                        ItemContainerStyle="{StaticResource FilterListBoxItemStyle}"
                        Margin="4"
                        SelectionMode="Extended"
                        SelectionChanged="filters_selection_changed"/>
                </Border>

                <TextBlock
                    x:Name="filter_count_text"
                    Grid.Row="6"
                    Style="{StaticResource StatusTextStyle}"
                    Text="Select a loaded link to display filters."
                    Margin="8,5,5,1"/>

                <StackPanel Grid.Row="7"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="Select All"
                            Width="105" Height="25"
                            Margin="5"
                            Click="button_select_all"/>

                    <Button Content="Select None"
                            Width="105" Height="25"
                            Margin="5"
                            Click="button_select_none"/>
                </StackPanel>

                <Button
                    x:Name="button_load"
                    Grid.Row="8"
                    Content="Load Selected Filters"
                    Width="220" Height="32"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    IsEnabled="False"
                    Click="button_run"/>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="{StaticResource HeaderBackground}"
                    BorderBrush="{StaticResource BorderGreen}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13">

                <TextBlock
                    Style="{StaticResource FooterTextStyle}"
                    Text="Version 1.0"/>
            </Border>
        </Grid>
    </Border>
</Window>