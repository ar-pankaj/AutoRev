<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="UI_Main"
        Title="Load View Templates From Link"
        Height="650" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="True" AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBg" Color="#D7DCE2"/>
        <SolidColorBrush x:Key="MainBg" Color="#E8EAED"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMain" Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#2589BD"/>
        <SolidColorBrush x:Key="ButtonNormal" Color="#2563A6"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#16A34A"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#0F7A35"/>
        <SolidColorBrush x:Key="BorderBlue" Color="#2589BD"/>
        <SolidColorBrush x:Key="BorderGreen" Color="#22A447"/>
        <SolidColorBrush x:Key="HoverBg" Color="#DDECF2"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#CDEED8"/>
        <SolidColorBrush x:Key="DisabledBg" Color="#B8C0C8"/>
        <SolidColorBrush x:Key="DisabledText" Color="#707A85"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ButtonNormal}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background"
                                        Value="{StaticResource DisabledBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LinkCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
        <Style x:Key="TemplateCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="TemplateListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource MainBg}"
            BorderBrush="{StaticResource BorderGreen}"
            BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="27"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource BorderGreen}"
                    BorderThickness="0,0,0,1" CornerRadius="13,13,0,0"
                    MouseDown="header_drag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="pyRevix" Margin="8,0,0,0"
                               Foreground="{StaticResource BrandBlue}"
                               FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="main_title" Grid.Column="1"
                               Text="Load View Templates From Link"
                               FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Close" Width="58" Height="21"
                            Margin="0,0,5,0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="button_close"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,10,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Content="1. Select Source Revit Link:"/>
                <ComboBox x:Name="UI_LinkSource" Grid.Row="1"
                          Style="{StaticResource LinkCombo}" Margin="5,0"
                          SelectionChanged="UIe_ComboBox_Changed"/>
                <CheckBox x:Name="UI_check_override" Grid.Row="2"
                          Content="Override Existing View Templates"
                          IsChecked="True" Margin="5,7,5,1"/>
                <Separator Grid.Row="3" Margin="5,7,5,4"
                           Background="{StaticResource BorderGreen}"/>

                <Grid x:Name="UI_Stack_ViewTemplates" Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="2. Select View Templates From Link:"/>
                    <DockPanel Grid.Row="1" Margin="5,0,5,6">
                        <TextBlock Text="Search" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="UI_TextBox_Filter"
                                 Style="{StaticResource SearchBox}" Height="27"
                                 TextChanged="UIe_text_filter_updated"/>
                    </DockPanel>
                    <Border Grid.Row="2" Margin="5,0"
                            Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderGreen}"
                            BorderThickness="1" CornerRadius="9">
                        <ListBox x:Name="UI_ListBox_ViewTemplates"
                                 Margin="4" Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource TemplateListItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource TemplateCheckBox}"
                                              IsChecked="{Binding IsChecked}">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,3,0,0">
                        <Button Content="Select All" Width="105" Height="25"
                                Margin="5" Click="UIe_btn_select_all"/>
                        <Button Content="Select None" Width="105" Height="25"
                                Margin="5" Click="UIe_btn_select_none"/>
                    </StackPanel>
                    <Button x:Name="UI_btn_Run" Grid.Row="4"
                            Content="Compare and Transfer Templates"
                            Width="240" Height="32" Margin="0,4,0,0"
                            HorizontalAlignment="Center" IsEnabled="False"
                            Click="UIe_btn_run"/>
                    <Border Grid.Row="5" Margin="5,8,5,0"
                            Background="{StaticResource PanelBg}"
                            BorderBrush="{StaticResource BorderGreen}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Margin="8,6">
                            <TextBlock Text="Comparison workflow" FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource TextSecondary}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Text="A read-only pyRevit comparison report is generated before any template is copied or replaced."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource HeaderBg}"
                    BorderBrush="{StaticResource BorderGreen}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,13,13">
                <TextBlock x:Name="footer_version" Text="Version 2.3"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="10" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
