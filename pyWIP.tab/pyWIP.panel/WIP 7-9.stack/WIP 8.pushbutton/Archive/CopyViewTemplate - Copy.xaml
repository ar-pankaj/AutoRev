<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="UI_Main"
    Title="Load View Templates From Link"
    Height="650"
    Width="450"
    MinHeight="650"
    MinWidth="450"
    MaxHeight="650"
    MaxWidth="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    AllowsTransparency="True"
    Background="Transparent">

    <Window.Resources>

        <!-- ====================================================== -->
        <!-- COLOURS                                                -->
        <!-- ====================================================== -->

        <SolidColorBrush x:Key="HeaderBg" Color="#D7DCE2"/>
        <SolidColorBrush x:Key="MainBg" Color="#E8EAED"/>
        <SolidColorBrush x:Key="PanelBg" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextMain" Color="#111111"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#667085"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BrandBlue" Color="#2589BD"/>

        <SolidColorBrush x:Key="ButtonNormal" Color="#2563A6"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#16A34A"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#0F7A35"/>

        <SolidColorBrush x:Key="BorderBlue" Color="#2589BD"/>
        <SolidColorBrush x:Key="BorderGreen" Color="#22A447"/>

        <SolidColorBrush x:Key="HoverBg" Color="#DDECF2"/>
        <SolidColorBrush x:Key="SelectedBg" Color="#CDEED8"/>

        <SolidColorBrush x:Key="DisabledBg" Color="#B8C0C8"/>
        <SolidColorBrush x:Key="DisabledText" Color="#707A85"/>

        <SolidColorBrush x:Key="ScrollTrack" Color="#D4D9DE"/>


        <!-- ====================================================== -->
        <!-- DEFAULT TEXTBLOCK                                      -->
        <!-- ====================================================== -->

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>


        <!-- ====================================================== -->
        <!-- DEFAULT LABEL                                          -->
        <!-- ====================================================== -->

        <Style TargetType="{x:Type Label}">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>


        <!-- ====================================================== -->
        <!-- BRAND TEXT                                             -->
        <!-- ====================================================== -->

        <Style x:Key="BrandText"
               TargetType="{x:Type TextBlock}">

            <Setter Property="Foreground"
                    Value="{StaticResource BrandBlue}"/>

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- WINDOW TITLE TEXT                                      -->
        <!-- ====================================================== -->

        <Style x:Key="TitleText"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- SEARCH LABEL TEXT                                      -->
        <!-- ====================================================== -->

        <Style x:Key="SearchText"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- STATUS TEXT                                            -->
        <!-- ====================================================== -->

        <Style x:Key="StatusText"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <!-- ====================================================== -->
        <!-- FOOTER TEXT                                            -->
        <!-- ====================================================== -->

        <Style x:Key="FooterText"
               TargetType="{x:Type TextBlock}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextSecondary}"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ====================================================== -->
        <!-- BUTTON STYLE                                           -->
        <!-- ====================================================== -->

        <Style TargetType="{x:Type Button}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Background"
                    Value="{StaticResource ButtonNormal}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextWhite}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBlue}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="5"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonHover}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonPressed}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.85"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBg}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource DisabledBg}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.65"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- SEARCH TEXTBOX STYLE                                   -->
        <!-- ====================================================== -->

        <Style x:Key="SearchBox"
               TargetType="{x:Type TextBox}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBg}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMain}"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource TextMain}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBlue}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="7,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border
                            x:Name="InputBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                Background="Transparent"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                            </Trigger>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderBlue}"/>

                                <Setter
                                    TargetName="InputBorder"
                                    Property="BorderThickness"
                                    Value="2"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    TargetName="InputBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBg}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- COMBOBOX ITEM STYLE                                    -->
        <!-- ====================================================== -->

        <Style x:Key="ComboItem"
               TargetType="{x:Type ComboBoxItem}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMain}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBg}"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">

                            <ContentPresenter
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource HoverBg}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter
                                    TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource SelectedBg}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- COMBOBOX TOGGLE TEMPLATE                               -->
        <!-- ====================================================== -->

        <ControlTemplate
            x:Key="ComboToggle"
            TargetType="{x:Type ToggleButton}">

            <Grid Background="{StaticResource InputBg}">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="ComboBorder"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource BorderBlue}"
                    BorderThickness="1"
                    CornerRadius="6"/>

                <Border
                    x:Name="ArrowBackground"
                    Grid.Column="1"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource BorderBlue}"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,6,6,0"/>

                <Path
                    x:Name="Arrow"
                    Grid.Column="1"
                    Width="8"
                    Height="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{StaticResource TextMain}"
                    Data="M 0 0 L 4 4 L 8 0 Z"/>

            </Grid>

            <ControlTemplate.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter
                        TargetName="ComboBorder"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource HoverBg}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                </Trigger>

                <Trigger Property="IsChecked"
                         Value="True">

                    <Setter
                        TargetName="ComboBorder"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource SelectedBg}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="BorderBrush"
                        Value="{StaticResource BorderGreen}"/>

                </Trigger>

                <Trigger Property="IsEnabled"
                         Value="False">

                    <Setter
                        TargetName="ComboBorder"
                        Property="Background"
                        Value="{StaticResource DisabledBg}"/>

                    <Setter
                        TargetName="ArrowBackground"
                        Property="Background"
                        Value="{StaticResource DisabledBg}"/>

                    <Setter
                        TargetName="Arrow"
                        Property="Fill"
                        Value="{StaticResource DisabledText}"/>

                </Trigger>

            </ControlTemplate.Triggers>

        </ControlTemplate>


        <!-- ====================================================== -->
        <!-- LINK COMBOBOX STYLE                                    -->
        <!-- ====================================================== -->

        <Style x:Key="LinkCombo"
               TargetType="{x:Type ComboBox}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBg}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMain}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBlue}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="MinHeight"
                    Value="28"/>

            <Setter Property="MaxDropDownHeight"
                    Value="260"/>

            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>

            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled"/>

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto"/>

            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ComboItem}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ComboBox}">

                        <Grid Background="{TemplateBinding Background}">

                            <ToggleButton
                                x:Name="ToggleButton"
                                Background="{TemplateBinding Background}"
                                Foreground="{TemplateBinding Foreground}"
                                Template="{StaticResource ComboToggle}"
                                Focusable="False"
                                ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen,
                                    Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}"/>

                            <ContentPresenter
                                Margin="8,3,34,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup
                                x:Name="Popup"
                                Placement="Bottom"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                AllowsTransparency="True"
                                Focusable="False"
                                PopupAnimation="Slide">

                                <Border
                                    x:Name="DropDownBorder"
                                    Margin="0,3,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource InputBg}"
                                    BorderBrush="{StaticResource BorderGreen}"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <ScrollViewer
                                        Margin="5"
                                        Background="Transparent"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel
                                            IsItemsHost="True"
                                            Background="Transparent"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="HasItems"
                                     Value="False">

                                <Setter
                                    TargetName="DropDownBorder"
                                    Property="MinHeight"
                                    Value="40"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    Property="Background"
                                    Value="{StaticResource DisabledBg}"/>

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- CHECKBOX STYLE                                         -->
        <!-- ====================================================== -->

        <Style TargetType="{x:Type CheckBox}">

            <Setter Property="FontFamily"
                    Value="Arial"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="Medium"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextMain}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBg}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBlue}"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Margin"
                    Value="5,3"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type CheckBox}">

                        <Border
                            x:Name="RowBackground"
                            Background="Transparent"
                            Padding="3"
                            CornerRadius="5">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="CheckBoxBorder"
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="3">

                                    <Path
                                        x:Name="CheckMark"
                                        Width="9"
                                        Height="7"
                                        Stroke="{StaticResource TextWhite}"
                                        StrokeThickness="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Data="M 0 3 L 3 6 L 9 0"/>

                                </Border>

                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"
                                    RecognizesAccessKey="True"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter
                                    TargetName="CheckBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource BorderGreen}"/>

                                <Setter
                                    TargetName="CheckBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                                <Setter
                                    TargetName="CheckMark"
                                    Property="Visibility"
                                    Value="Visible"/>

                                <Setter
                                    TargetName="RowBackground"
                                    Property="Background"
                                    Value="{StaticResource SelectedBg}"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="RowBackground"
                                    Property="Background"
                                    Value="{StaticResource HoverBg}"/>

                                <Setter
                                    TargetName="CheckBoxBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource BorderGreen}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource DisabledText}"/>

                                <Setter
                                    TargetName="CheckBoxBorder"
                                    Property="Background"
                                    Value="{StaticResource DisabledBg}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- LISTBOX ITEM STYLE                                     -->
        <!-- ====================================================== -->

        <Style x:Key="TemplateListItem"
               TargetType="{x:Type ListBoxItem}">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Focusable"
                    Value="False"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ListBoxItem}">

                        <Border
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- SCROLLBAR THUMB                                        -->
        <!-- ====================================================== -->

        <Style x:Key="ScrollThumb"
               TargetType="{x:Type Thumb}">

            <Setter Property="MinHeight"
                    Value="22"/>

            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Thumb}">

                        <Border
                            x:Name="ThumbBorder"
                            Margin="1"
                            Background="{StaticResource BorderBlue}"
                            CornerRadius="5"/>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource BorderGreen}"/>

                            </Trigger>

                            <Trigger Property="IsDragging"
                                     Value="True">

                                <Setter
                                    TargetName="ThumbBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonHover}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ====================================================== -->
        <!-- VERTICAL SCROLLBAR                                     -->
        <!-- ====================================================== -->

        <Style TargetType="{x:Type ScrollBar}">

            <Setter Property="Width"
                    Value="11"/>

            <Setter Property="Margin"
                    Value="2"/>

            <Setter Property="Background"
                    Value="{StaticResource ScrollTrack}"/>

            <Setter Property="OverridesDefaultStyle"
                    Value="True"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type ScrollBar}">

                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5">

                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Focusable="False">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb Style="{StaticResource ScrollThumb}"/>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ========================================================== -->
    <!-- WINDOW BORDER                                              -->
    <!-- ========================================================== -->

    <Border
        Background="{StaticResource MainBg}"
        BorderBrush="{StaticResource BorderGreen}"
        BorderThickness="1"
        CornerRadius="14">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="27"/>
            </Grid.RowDefinitions>


            <!-- ================================================== -->
            <!-- HEADER                                             -->
            <!-- ================================================== -->

            <Border
                Grid.Row="0"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource BorderGreen}"
                BorderThickness="0,0,0,1"
                CornerRadius="13,13,0,0"
                MouseDown="header_drag">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="65"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Style="{StaticResource BrandText}"
                        Text="pyRevix"
                        Margin="8,0,0,0"/>

                    <TextBlock
                        x:Name="main_title"
                        Grid.Column="1"
                        Style="{StaticResource TitleText}"
                        Text="Load View Templates From Link"/>

                    <Button
                        Grid.Column="2"
                        Content="Close"
                        Width="58"
                        Height="21"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="button_close"/>

                </Grid>

            </Border>


            <!-- ================================================== -->
            <!-- MAIN CONTENT                                       -->
            <!-- ================================================== -->

            <Grid
                Grid.Row="1"
                Margin="12,10,12,8">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- SOURCE LINK LABEL -->

                <Label
                    Grid.Row="0"
                    Content="1. Select Source Revit Link:"/>


                <!-- SOURCE LINK COMBOBOX -->

                <ComboBox
                    x:Name="UI_LinkSource"
                    Grid.Row="1"
                    Style="{StaticResource LinkCombo}"
                    Margin="5,0"
                    SelectionChanged="UIe_ComboBox_Changed"/>


                <!-- OVERRIDE OPTION -->

                <CheckBox
                    x:Name="UI_check_override"
                    Grid.Row="2"
                    Content="Override Existing View Templates"
                    IsChecked="True"
                    Margin="5,7,5,1"/>


                <!-- SEPARATOR -->

                <Separator
                    Grid.Row="3"
                    Margin="5,7,5,4"
                    Background="{StaticResource BorderGreen}"/>


                <!-- ============================================== -->
                <!-- COMPLETE VIEW TEMPLATE AREA                    -->
                <!-- ============================================== -->

                <Grid
                    x:Name="UI_Stack_ViewTemplates"
                    Grid.Row="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TEMPLATE LABEL -->

                    <Label
                        Grid.Row="0"
                        Content="2. Select View Templates From Link:"/>


                    <!-- SEARCH -->

                    <DockPanel
                        Grid.Row="1"
                        Margin="5,0,5,6">

                        <TextBlock
                            Style="{StaticResource SearchText}"
                            Text="Search"
                            Margin="0,0,8,0"/>

                        <TextBox
                            x:Name="UI_TextBox_Filter"
                            Style="{StaticResource SearchBox}"
                            Height="27"
                            TextChanged="UIe_text_filter_updated"/>

                    </DockPanel>


                    <!-- VIEW TEMPLATE LIST -->

                    <Border
                        Grid.Row="2"
                        Margin="5,0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderGreen}"
                        BorderThickness="1"
                        CornerRadius="9">

                        <ListBox
                            x:Name="UI_ListBox_ViewTemplates"
                            Margin="4"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionMode="Single"
                            ItemContainerStyle="{StaticResource TemplateListItem}"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <CheckBox
                                        IsChecked="{Binding IsChecked}"
                                        HorizontalContentAlignment="Stretch">

                                        <TextBlock
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap"/>

                                    </CheckBox>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Border>


                    <!-- SELECT ALL / SELECT NONE -->

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,3,0,0">

                        <Button
                            Content="Select All"
                            Width="105"
                            Height="25"
                            Margin="5"
                            Click="UIe_btn_select_all"/>

                        <Button
                            Content="Select None"
                            Width="105"
                            Height="25"
                            Margin="5"
                            Click="UIe_btn_select_none"/>

                    </StackPanel>


                    <!-- TRANSFER BUTTON -->

                    <StackPanel
                        x:Name="UI_stack_button"
                        Grid.Row="4">

                        <Button
                            x:Name="UI_btn_Run"
                            Content="Transfer Selected Templates"
                            Width="240"
                            Height="32"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            IsEnabled="False"
                            Click="UIe_btn_run"/>

                    </StackPanel>


                    <!-- WARNING -->

                    <Border
                        Grid.Row="5"
                        Margin="5,8,5,0"
                        Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource BorderGreen}"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel Margin="8,6">

                            <TextBlock
                                Text="Warning"
                                FontSize="11"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Style="{StaticResource StatusText}"
                                Margin="0,2,0,0"
                                Text="View Templates may transfer dependent filters, parameters and other settings."/>

                            <TextBlock
                                Style="{StaticResource StatusText}"
                                Text="Review imported templates before applying them across the project."/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Grid>


            <!-- ================================================== -->
            <!-- FOOTER                                             -->
            <!-- ================================================== -->

            <Border
                Grid.Row="2"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource BorderGreen}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,13,13">

                <TextBlock
                    x:Name="footer_version"
                    Style="{StaticResource FooterText}"
                    Text="Version 2.0"/>

            </Border>

        </Grid>

    </Border>

</Window>